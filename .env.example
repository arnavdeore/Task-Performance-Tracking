# Copy this file to .env and fill in the two values. .env is ignored by git; this example file is committed.
# Supabase dashboard > Project Settings > API.

# Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The PUBLIC key only: the "anon" key (or the "publishable" key, sb_publishable_...). It is safe in the browser because
# Row Level Security protects the data. NEVER paste the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-public-anon-key
